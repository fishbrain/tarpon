{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "customManagers": [
        {
            "customType": "regex",
            "datasourceTemplate": "docker",
            "managerFilePatterns": [
                ".datadog-agent-version"
            ],
            "matchStrings": [
                "(?<currentValue>[^\\s]+)"
            ],
            "packageNameTemplate": "datadog/agent"
        }
    ],
    "description": "This file is managed by Terraform. Manual changes will be overwritten. To update this file, look for the `renovate_config` module being used in the `repositories` directory in our Terraform repo.",
    "extends": [
        "config:recommended",
        "docker:pinDigests",
        "helpers:pinGitHubActionDigests",
        ":configMigration",
        ":pinDevDependencies",
        ":pinDependencies",
        "abandonments:recommended",
        ":rebaseStalePrs",
        "helpers:pinGitHubActionDigestsToSemver",
        ":automergePatch"
    ],
    "hostRules": [],
    "ignorePaths": [
        "node_modules/**"
    ],
    "internalChecksFilter": "strict",
    "minimumReleaseAge": "7 days",
    "packageRules": [
        {
            "matchPackageNames": [
                "datadog/agent"
            ],
            "pinDigests": false
        },
        {
            "matchPackageNames": [
                "fishbrain/shared-workflows",
                "@fishbrain/eslint-config-base",
                "@fishbrain/eslint-config-react"
            ],
            "minimumReleaseAge": "0 days"
        },
        {
            "automerge": true,
            "labels": [],
            "matchPackageNames": [
                "@types/**"
            ],
            "matchUpdateTypes": [
                "minor",
                "patch",
                "pin",
                "digest"
            ]
        },
        {
            "automerge": true,
            "extends": [
                "packages:linters"
            ],
            "labels": [],
            "matchUpdateTypes": [
                "minor",
                "patch",
                "pin",
                "digest"
            ]
        },
        {
            "automerge": true,
            "extends": [
                "packages:test"
            ],
            "labels": [],
            "matchUpdateTypes": [
                "minor",
                "patch",
                "pin",
                "digest"
            ]
        }
    ],
    "prConcurrentLimit": 10,
    "reviewersFromCodeOwners": true,
    "schedule": [
        "* * * * 1-5"
    ]
}